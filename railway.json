{
  "services": {
    "bot": {
      "type": "worker",
      "startCommand": "python -m bot.app",
      "env": {
        "ZALO_BOT_TOKEN": "${{ZALO_BOT_TOKEN}}",
        "MISTRAL_API_KEY": "${{MISTRAL_API_KEY}}",
        "ADMIN_PASSWORD": "${{ADMIN_PASSWORD}}",
        "SECRET_KEY": "${{SECRET_KEY}}",
        "BRINGH_DATA_DIR": "/app/data",
        "OCR_PROVIDER": "easyocr",
        "PYTHONPATH": "/app"
      },
      "volumes": [
        {
          "path": "/app/data",
          "name": "bringh-data"
        }
      ]
    },
    "admin": {
      "type": "web",
      "port": 8080,
      "startCommand": "python -m admin.app",
      "env": {
        "ZALO_BOT_TOKEN": "${{ZALO_BOT_TOKEN}}",
        "MISTRAL_API_KEY": "${{MISTRAL_API_KEY}}",
        "ADMIN_PASSWORD": "${{ADMIN_PASSWORD}}",
        "SECRET_KEY": "${{SECRET_KEY}}",
        "BRINGH_DATA_DIR": "/app/data",
        "ADMIN_PORT": "8080",
        "OCR_PROVIDER": "easyocr",
        "PYTHONPATH": "/app"
      },
      "volumes": [
        {
          "path": "/app/data",
          "name": "bringh-data"
        }
      ]
    }
  }
}
